#include config
#include utils

local pokemon_ui_api

function onLoad()
  math.randomseed(os.time())
  deduplicate_models()
  set_custom_assets()
end

--
--
--

function _mass_add_tags()
  local count = 0
  for _, object in pairs(getObjectsWithAllTags({"Ability Card", "Breach Card", "Pokemon Card", "Village Card", "Held Item"})) do
    count = count + 1
    object.removeTag("Held Item")
  end
  print(count)
end

function _count_trees()
  counts = {}
  for _, tree in pairs(getObjectsWithTag(config.tags.world.APRICORN_TREE)) do
    local id = tree.getName() .. " / " .. get_biome_tag(tree.getTags()) .. " / " .. get_climate_tag(tree.getTags())
    if counts[id] == nil then
      counts[id] = 1
    else
      counts[id] = counts[id] + 1
    end
  end
  local tkeys = {}
  -- populate the table that holds the keys
  for k in pairs(counts) do table.insert(tkeys, k) end
  -- sort the keys
  table.sort(tkeys)
  -- use the keys to retrieve the values in the sorted order
  for _, k in ipairs(tkeys) do log(k .. ": " .. counts[k]) end
end

function deduplicate_models()
  -- This method should not be necessary, but good to have just in case
  for _, object in pairs(getObjectsWithTag(config.tags.objects.POKEMON_MODEL)) do
    if object.type == "Bag" then
      local models_in_bag = {}
      for _, model in pairs(object:getObjects()) do
        if not models_in_bag[model.name] then
          models_in_bag[model.name] = 1
        else
          models_in_bag[model.name] = models_in_bag[model.name] + 1
          local model = object:takeObject({guid=model.guid})
          model:destroyObject()
        end
      end
    end
  end
end

--
-- Global Zone Handler
