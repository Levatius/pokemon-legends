    children = {
      {
        tag = "HorizontalLayout",
        attributes = {
          anchorMin = ui_tuple({2/16, 3/5}),
          anchorMax = ui_tuple({14/16, 5/5}),
          --
          spacing        = 5,
          childAlignment = "MiddleCenter",
        },
        children = {
          status_button_ui(guid, "Confused"),
          status_button_ui(guid, "Paralysed"),
          status_button_ui(guid, "Poisoned"),
          status_button_ui(guid, "Burned"),
          status_button_ui(guid, "Frozen"),
          status_button_ui(guid, "Drowsy"),
        }
      },
      {
        tag = "Panel",
        attributes = {
          anchorMin = ui_tuple({0/16, 0/5}),
          anchorMax = ui_tuple({16/16, 3/5}),
        },
        children = {
          {
            tag = "Slider",
            attributes = {
              width  = "25%",
              height = "50%",
              --
              scale = ui_tuple({4, 2.25, 1}),
              --
              id = "HealthSlider" .. guid,
              --
              onValueChanged  = api_func("move_health_slider"),
              minValue        = 0,
              maxValue        = 0,
              wholeNumbers    = true,
              backgroundColor = ui_colour(Color.AtiusBlack),
              fillColor       = ui_colour(Color.ActiveGreen),
              handleImage     = "HealthSliderHandle",
            }
          },
          {
            tag = "Text",
            attributes = {
              anchorMin = ui_tuple({0.2/16, 0.7/3}),
              anchorMax = ui_tuple({1.8/16, 2.3/3}),
              --
              id = "HealthSliderText" .. guid,
              --
              text                 = "?",
              alignment            = "MiddleLeft",
              color                = ui_colour(Color.AtiusBlack),
