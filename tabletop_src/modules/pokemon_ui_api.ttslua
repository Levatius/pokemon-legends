function innate_ability_image_ui(guid, innate_ability_name)
  return {
    tag = "Image",
    attributes = {
      active = false,
      id     = "InnateAbilityImage" .. guid,
      --
      image          = innate_ability_name,
      preserveAspect = true,
      --
      showAnimation = "FadeIn",
      hideAnimation = "FadeOut",
    }
  }
end

--
--
--

function add(params)
  local guid = params.guid
  local pokemon_card = getObjectFromGUID(guid)
  local innate_ability_name = get_innate_ability_name(pokemon_card)
  local pokemon_stats = pokemon_stats_store.call("get", {guid=guid})

  local WIDTH = 215
  local RATIO = 28/16

  local ui_elements = {
    {
      tag = "Panel",
      attributes = {
        width  = tostring(WIDTH * UI_SCALE),
        height = tostring(WIDTH * UI_SCALE * RATIO),
        --
        position = ui_tuple({0, 0, -25}),
        rotation = ui_tuple({0, 0, 180}),
        scale    = ui_tuple({1/UI_SCALE, (1/UI_SCALE)*0.82, 1}),
      },
      children = {
        action_buttons_ui(guid),
        transform_button_ui(guid),
        evolve_button_ui(guid),
        stats_button_ui(guid, {11.75/16, 18.25/28}, {15.25/16, 20.25/28}, "Health", "click_health_button"),
        stats_button_ui(guid, {11.75/16, 15.75/28}, {15.25/16, 17.75/28}, "Initiative", "click_initiative_button"),
        health_panel_ui(guid),
        innate_ability_image_ui(guid, innate_ability_name),
      }
    },
  }

  if len(pokemon_card.UI.getXmlTable()) == 0 then
    pokemon_card.UI.setXmlTable(ui_elements, UI.getCustomAssets())
  end

  Wait.condition(
    function() update_ui(guid) end,
    function() return has_ui_loaded(pokemon_card) end
  )
end

function show(params)
  local guid = params.guid
  local pokemon_card = getObjectFromGUID(guid)

  if not pokemon_card or len(pokemon_card.UI.getXmlTable()) == 0 then
    return
  end

  if not tobool(pokemon_card.UI.getAttribute("HealthPanel" .. guid, "active")) then
    pokemon_card.UI.show("HealthPanel" .. guid)
  end
  if not tobool(pokemon_card.UI.getAttribute("InnateAbilityImage" .. guid, "active")) and pokemon_card.UI.getAttribute("InnateAbilityImage" .. guid, "image") ~= nil then
    if params.zone ~= nil then
      pokemon_card.UI.setAttribute("InnateAbilityImage" .. guid, "position", ui_tuple({0, -1190, 30 + count_face_down(params.zone) * 50}))
    end
    pokemon_card.UI.show("InnateAbilityImage" .. guid)
  end
end

function hide(params)
  local guid = params.guid
  local pokemon_card = getObjectFromGUID(guid)

  if not pokemon_card or len(pokemon_card.UI.getXmlTable()) == 0 then
    return
  end

  pokemon_card.UI.hide("HealthPanel" .. guid)
  pokemon_card.UI.hide("InnateAbilityImage" .. guid)
end
