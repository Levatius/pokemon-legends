              attributes = {
                id = "HealthButtonText" .. guid,
                text = "?",
                alignment = "MiddleCenter",
                color = ui_colour(Color.AtiusBlack),
                font = "Fonts/La Oriental",
                resizeTextForBestFit = true,
                anchorMin = ui_tuple({-0.2, -0.33}),
                anchorMax = ui_tuple({0.8, 1.33}),
                scale = ui_tuple({0.5, 0.5, 1}),
                width = "100%",
                height = "100%",
              }
            },
          }
        },
        {
          tag = "Panel",
          attributes = {
            anchorMin = ui_tuple({0.75, 0.555}),
            anchorMax = ui_tuple({0.98, 0.62}),
          },
          children = {
            {
              tag = "Button",
              attributes = {
                id = "InitiativeButton" .. guid,
                onClick = "Global/click_initiative_button",
                sprite = "InitiativeBase",
              }
            },
            {
              tag = "Text",
              attributes = {
                id = "InitiativeButtonText" .. guid,
                text = "?",
                alignment = "MiddleCenter",
                color = ui_colour(Color.AtiusBlack),
                font = "Fonts/La Oriental",
                resizeTextForBestFit = true,
                anchorMin = ui_tuple({-0.2, -0.33}),
                anchorMax = ui_tuple({0.8, 1.33}),
                scale = ui_tuple({0.5, 0.5, 1}),
                width = "100%",
                height = "100%",
              }
            },
          }
        },
        {
          tag = "Panel",
          attributes = {
            id = "HealthPanel" .. guid,
            anchorMin = ui_tuple({-0.05, 0.925}),
            anchorMax = ui_tuple({1.05, 1.075}),
            showAnimation = "Grow",
