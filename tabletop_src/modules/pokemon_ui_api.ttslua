                  tag = "Button",
                  attributes = {
                    id = "ConfusedStatus" .. guid,
                    onClick = "Global/toggle_status_button",
                    sprite = "ConfusedStatus0",
                  }
                },
                {
                  tag = "Button",
                  attributes = {
                    id = "ParalysedStatus" .. guid,
