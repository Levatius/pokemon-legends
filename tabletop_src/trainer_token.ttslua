#include config
#include utils

ENCOUNTER_COLOURS = {
  [config.tags.encounters.STARTER]   = Color.StarterPink,
  [config.tags.encounters.WEAK]      = Color.WeakGreen,
  [config.tags.encounters.MODERATE]  = Color.ModerateBlue,
  [config.tags.encounters.STRONG]    = Color.StrongRed,
  [config.tags.encounters.LEGENDARY] = Color.LegendaryYellow,
}
ENCOUNTER_COUNTS = {
  [config.tags.encounters.GALACTIC_GRUNT]             = 2,
  [config.tags.encounters.GALACTIC_COMMANDER_JUPITER] = 4,
  [config.tags.encounters.GALACTIC_COMMANDER_MARS]    = 4,
  [config.tags.encounters.GALACTIC_COMMANDER_SATURN]  = 4,
  [config.tags.encounters.GALACTIC_BOSS]              = 6,
}

local search_params = {}
local search_button_hide_timer_id

function onLoad()
  pokemon_decks_api = get_module("pokemon_decks_api")

  Wait.condition(load_panel, has_ui_loaded)
end

--
-- UTILS
--

function get_player()
  for _, player in pairs(Player.getPlayers()) do
    if self.getColorTint() == Color.fromString(player.color) then
      return player
    end
  end
end

function does_player_have_artifact(sanctuary_name)
  local player = get_player()
  if not player then
    return false
  end
  local hand = player.getHandTransform(1)
  if not hand then
    return false
  end
  local player_pokemon_zones = {find_closest(hand.position, {config.tags.zones.POKEMON_SLOT}, "Scripting", 6)}

  for _, zone in pairs(player_pokemon_zones) do
    for _, object in pairs(zone.getObjects(true)) do
      if object.hasTag(config.tags.items.ARTIFACT) then
        for artifact_sactuary_name in split(object.getGMNotes(), "/") do
          if artifact_sactuary_name == sanctuary_name then
            return true
          end
        end
      end
    end
  end
  return false
end

function find_search_params()
  local hit_list = Physics.cast({
    origin       = self.getPosition(),
    direction    = {0, -1, 0},
    type         = 2,
    size         = {1.5, 1.5, 1.5},
    max_distance = 2,
  })
  for _, hit_info in ipairs(hit_list) do
    local hit_object = hit_info.hit_object
    -- Sanctuaries
    if hit_object.hasTag(config.tags.world.SANCTUARY) and does_player_have_artifact(hit_object.getName()) then
      set_search_params(hit_object)
      show_search_button()
      break
    -- Encounters
    elseif hit_object.hasTag(config.tags.world.ENCOUNTER) and not hit_object.is_face_down then
      set_search_params(hit_object)
      show_search_button()
      break
    end
  end
end

function set_search_params(hit_object)
  local tags = hit_object.getTags()
  local encounter = get_encounter_tag(tags)
  local count = ENCOUNTER_COUNTS[encounter]

  search_params = {
    encounter = encounter,
    biome     = get_biome_tag(tags),
    climate   = get_climate_tag(tags),
    names     = hit_object.getGMNotes(),
    count     = (count ~= nil) and count or 2,
  }
end

--
--
--

function update_colour_tint(player_colour)
  -- Clear player colour from other trainer tokens
  local trainer_tokens = getObjectsWithTag(config.tags.objects.TRAINER)
  for _, trainer_token in pairs(trainer_tokens) do
    if trainer_token.getColorTint() == Color.fromString(player_colour) then
      trainer_token.setColorTint({0, 0, 0, 0.25})
    end
  end
  -- Set on this token
  self.setColorTint(player_colour)
end

function is_choice(pokemon_cards)
  local is_campaign_battle = contains({
    config.tags.encounters.GALACTIC_GRUNT,
    config.tags.encounters.GALACTIC_COMMANDER_JUPITER,
    config.tags.encounters.GALACTIC_COMMANDER_MARS,
    config.tags.encounters.GALACTIC_COMMANDER_SATURN,
    config.tags.encounters.GALACTIC_BOSS,
  }, search_params.encounter)
  return (not is_campaign_battle) and len(pokemon_cards) > 1
end

--
--
--

function onPickUp(player_colour)
  hide_search_button(0)
  update_colour_tint(player_colour)
  pokemon_decks_api.call("return_pokemon_cards", {owner_guid=self.getGUID()})
end

function onDrop()
  Wait.condition(find_search_params, function() return self.resting end, 2)
end

--
--
--

function show_search_button()
  update_panel()
  self.UI.show("SearchButton")
  hide_search_button(5)
end

function hide_search_button(delay)
  if search_button_hide_timer_id then
    Wait.stop(search_button_hide_timer_id)
    search_button_hide_timer_id = nil
  end

  function hide()
    self.UI.hide("SearchButton")
    search_button_hide_timer_id = nil
  end
  search_button_hide_timer_id = Wait.time(hide, delay)
end

function click_search_button()
  hide_search_button(0)
  local pokemon_cards = pokemon_decks_api.call("find_pokemon_cards", search_params)
  pokemon_decks_api.call("layout_pokemon_cards", {
    owner_guid    = self.getGUID(),
    position      = self.getPosition(),
    pokemon_cards = pokemon_cards,
  })
  -- Send directly to arena if there is no choice
  if not is_choice(pokemon_cards) then
    pokemon_decks_api.call("battle_pokemon_cards", {
      pokemon_cards = pokemon_cards,
    })
  end
end

--
--
--

function load_panel()
  local ui_elements = {
    {
      tag = "Panel",
      attributes = {
        position = ui_tuple({0, 0, -600}),
        rotation = ui_tuple({270, 0, 0}),
        scale    = ui_tuple({1, 1, 1}),
        width    = 300,
        height   = 450,
      },
      children = {
        tag = "Button",
        attributes = {
          active  = false,
          id      = "SearchButton",
          onClick = "click_search_button",
          --
          color = ui_colour(Color(0, 0, 0, 0)),
          --
          textShadow           = ui_colour(Color.AtiusBlack),
          textOutline          = ui_colour(Color.AtiusBlack),
          font                 = "Fonts/La Oriental",
          resizeTextMaxSize    = 350,
          resizeTextForBestFit = true,
          --
          showAnimation = "Grow",
          hideAnimation = "Shrink",
        },
      }
    },
  }
  self.UI.setXmlTable(ui_elements, UI.getCustomAssets())

  Wait.condition(update_panel, has_ui_loaded)
end

function update_panel()
  local encounter_colour = ENCOUNTER_COLOURS[search_params.encounter]
  self.UI.setAttribute("SearchButton", "color", (encounter_colour ~= nil) and ui_colour(encounter_colour) or ui_colour(Color.AtiusBlack))
  self.UI.setAttribute("SearchButton", "text", "?")
  self.UI.setAttribute("SearchButton", "textColor", ui_colour(Color.White))
end
