#include config
#include utils

ENCOUNTER_COLOURS = {
  [config.tags.encounters.WEAK]      = Color.WeakGreen,
  [config.tags.encounters.MODERATE]  = Color.ModerateBlue,
  [config.tags.encounters.STRONG]    = Color.StrongRed,
  [config.tags.encounters.LEGENDARY] = Color.LegendaryYellow,
}

local search_params = {}
local search_button_hide_timer_id

function onLoad()
  Wait.condition(load_panel, has_ui_loaded)
end

function get_player()
  for _, player in pairs(Player.getPlayers()) do
    if self.getColorTint() == Color.fromString(player.color) then
      return player
    end
  end
end

--
--
--

function player_has_artifact(sanctuary_name)
  local player = get_player()
  if not player then
    return false
  end
  local hand = player.getHandTransform(1)
  if not hand then
    return false
  end
  local player_pokemon_zones = {find_closest(hand.position, {config.tags.zones.POKEMON_SLOT}, "Scripting", 6)}

  for _, zone in pairs(player_pokemon_zones) do
    for _, object in pairs(zone.getObjects(true)) do
      if object.hasTag(config.tags.items.ARTIFACT) then
        for artifact_sactuary_name in split(object.getGMNotes(), "/") do
          if artifact_sactuary_name == sanctuary_name then
            return true
          end
        end
      end
    end
  end
  return false
end

function find_search_params()
  local hit_list = Physics.cast({
    origin       = self.getPosition(),
    direction    = {0, -1, 0},
    type         = 2,
    size         = {1.5, 1.5, 1.5},
    max_distance = 2,
  })
  for _, hit_info in ipairs(hit_list) do
    local hit_object = hit_info.hit_object
    -- Campaign Tokens
    if hit_object.hasTag(config.tags.world.CAMPAIGN) then
      break
    -- Sanctuaries
    elseif hit_object.hasTag(config.tags.world.SANCTUARY) and player_has_artifact(hit_object.getName()) then
      set_search_params(hit_object)
      show_search_button()
      break
    -- Encounters
    elseif hit_object.hasTag(config.tags.world.ENCOUNTER) and not hit_object.is_face_down then
      set_search_params(hit_object)
      show_search_button()
      break
    end
  end
end

function set_search_params(hit_object)
  local tags = hit_object.getTags()

  search_params = {
    encounter = get_encounter_tag(tags),
    biome = get_biome_tag(tags),
    climate = get_climate_tag(tags),
    name = hit_object.getGMNotes(),
  }
end

-- local legendary_names = split(hit_object.getGMNotes(), "/")
